# Offline deterministic default. Supported primary modes: mock, codex-account.
FACTORY_MODE=mock

# Validation profile. `fast` is a cheap local/demo lane; `production` enables
# operating, stage-contract, platform and human-acceptance gates by default.
# FACTORY_VALIDATION_MODE=fast

# Explicit gate overrides (leave commented to inherit the validation profile).
# FACTORY_ENFORCE_ACCEPTANCE=1
# FACTORY_ENFORCE_OPERATING_GATES=1
# FACTORY_ENFORCE_STAGE_CONTRACTS=1
# FACTORY_ENFORCE_EXPLICIT_STAGE_CONTRACTS=1
# FACTORY_REQUIRE_UNKNOWN_REGISTER=1
# FACTORY_ENFORCE_PRESENTATION_QA=1
# FACTORY_ENFORCE_SUPPLY_CHAIN=1
# FACTORY_ENFORCE_ART_GATE=1
# FACTORY_ENFORCE_BLIND_PLAYTEST=1
# FACTORY_BLIND_PLAYTEST_REQUIRED=1
# FACTORY_ENFORCE_DIFFERENTIATION=1
# In `production`, certification, platform package QA, presentation QA,
# blind-playtest QA, supply-chain/dependency review and asset-edge QA are
# enabled automatically.  These switches are migration-only diagnostic
# bypasses; the effective policy is still written to operating-status and a
# bypassed run is not a clean production release.
# FACTORY_DISABLE_CERTIFICATION=1
# FACTORY_DISABLE_PLATFORM_QA=1
# FACTORY_DISABLE_PRESENTATION_QA=1
# FACTORY_DISABLE_BLIND_PLAYTEST=1
# FACTORY_DISABLE_SUPPLY_CHAIN=1
# FACTORY_DISABLE_ART_GATE=1
# FACTORY_DISABLE_PLATFORM_POLICY=1
# FACTORY_ENFORCE_CERTIFICATION=1
# FACTORY_ENFORCE_DEPENDENCY_ALLOWLIST=1
# FACTORY_REQUIRE_DEPENDENCY_ALLOWLIST=1
# FACTORY_DISABLE_DEPENDENCY_ALLOWLIST=1
# FACTORY_REQUIRE_FIRST_GAME_GATE=1
# FACTORY_DISABLE_FIRST_GAME_GATE=1
# FACTORY_DEPENDENCY_POLICY_PATH=/absolute/path/to/dependency-allowlist.json
# FACTORY_ENFORCE_PLATFORM_POLICY=1
# FACTORY_PLATFORM_POLICY_PATH=/absolute/path/to/platform-policy.json

# Cost accounting and stop-before-spend policy. Values are CNY cents; leaving
# them at zero is an explicit local/free-run assumption, not a vendor price
# claim. The immutable run artifact records the effective rate card.
# FACTORY_COST_AGENT_INPUT_CENTS_PER_1K=0
# FACTORY_COST_AGENT_OUTPUT_CENTS_PER_1K=0
# FACTORY_COST_IMAGE_CALL_CENTS=0
# FACTORY_COST_HUMAN_MINUTE_CENTS=0
# FACTORY_COST_RATE_SOURCE=factory-default:local-accounting
# FACTORY_COST_RATE_EFFECTIVE_AT=1970-01-01T00:00:00.000Z
# FACTORY_REQUIRE_PORTFOLIO_SNAPSHOT=1

# Production research/image network policy. Hosts are comma- or whitespace-
# separated DNS names; production fails closed when the research allow-list is
# empty. Never put credentials or tokens here.
# FACTORY_REQUIRE_RESEARCH_ALLOWLIST=1
# FACTORY_RESEARCH_ALLOWED_HOSTS=itch.io,github.com
# FACTORY_REQUIRE_RESEARCH_SOURCES=1
# FACTORY_IMAGE_ALLOWED_HOSTS=images.example.com

# Target platform selection. The seed still carries the mandatory WeChat,
# Douyin and TapTap targets; this only selects the primary child for a run.
# FACTORY_PRIMARY_PLATFORM=wechat-minigame
# FACTORY_ROOT=/absolute/path/to/factory-runs

# mock for FACTORY_MODE=mock; codex-imagegen for FACTORY_MODE=codex-account.
ART_PROVIDER=mock

# Optional Codex CLI controls. Authentication comes only from `codex login`.
CODEX_MODEL=
CODEX_EXEC_TIMEOUT_MS=300000
# 0 disables retry; 1 allows one retry. Values above 1 are clamped to 1.
CODEX_EXEC_MAX_RETRIES=1

# Separate long-running workspace-write budgets for Builder and Fixer.
# Defaults: Builder 15 minutes; Fixer 10 minutes.
CODEX_BUILD_TIMEOUT_MS=900000
CODEX_FIX_TIMEOUT_MS=600000

# Model aliases and per-tier input budgets. Max is a reasoning setting, not a
# permission setting; stage contracts still cap the tier and sandbox.
# FACTORY_FRONTIER_MODEL=gpt-5.6-luna
# FACTORY_FRONTIER_REASONING=max
# FACTORY_FRONTIER_MAX_INPUT_CHARS=64000
# FACTORY_BUILDER_MODEL=gpt-5.6-luna
# FACTORY_BUILDER_REASONING=max
# FACTORY_BUILDER_MAX_INPUT_CHARS=64000
# FACTORY_REVIEWER_MODEL=gpt-5.6-luna
# FACTORY_REVIEWER_REASONING=max
# FACTORY_REVIEWER_MAX_INPUT_CHARS=32000
# FACTORY_FAST_MODEL=gpt-5.6-luna
# FACTORY_FAST_REASONING=max
# FACTORY_FAST_MAX_INPUT_CHARS=18000

# Optional stage-level model override, for a reviewed migration only.
# FACTORY_STAGE_COMPETITOR_RESEARCH_MODEL=gpt-5.6-sol

# Diagnostic-only compatibility switches. They must not be enabled for a
# production release: they allow a missing/unsupported line to continue and
# can therefore produce evidence that is not publishable.
# FACTORY_ALLOW_UNIMPLEMENTED_LINE=1
# FACTORY_ALLOW_UNSUPPORTED_LINE=1

# codex-account does not require any API-key or OpenAI API model variable.
