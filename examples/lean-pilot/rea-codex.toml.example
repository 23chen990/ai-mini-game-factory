# EXAMPLE ONLY: not loaded by Codex from this location and NOT installed here.
# Only after explicit installation/configuration approval, in a separate research profile.
# Use the exact approved absolute CLI path/version, not npx @latest.
# A tool allowlist is not an OS filesystem/network sandbox or proof of permission.
[mcp_servers.rea_research]
command = "/ABSOLUTE/PATH/TO/APPROVED/rea"
args = ["mcp"]
enabled = false
required = false
enabled_tools = ["analyze_javascript_application"]
default_tools_approval_mode = "prompt"
startup_timeout_sec = 20
tool_timeout_sec = 90
